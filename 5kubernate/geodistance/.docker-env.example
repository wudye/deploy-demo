# 远程 Docker 配置示例
# 根据您的实际环境修改以下配置

# 方式 1: 使用环境变量
# DOCKER_HOST=tcp://192.168.80.131:2375

# 方式 2: 使用 Java 系统属性
# -Ddocker.host=tcp://192.168.80.131:2375

# Windows PowerShell
# $env:DOCKER_HOST="tcp://192.168.80.131:2375"
# mvn test

# Windows CMD
# set DOCKER_HOST=tcp://192.168.80.131:2375
# mvn test

# Linux/Mac
# export DOCKER_HOST=tcp://192.168.80.131:2375
# mvn test
