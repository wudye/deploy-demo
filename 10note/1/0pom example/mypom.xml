<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    
    <modelVersion>4.0.0</modelVersion>
    
    <!-- Spring Boot 父 POM -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.1</version>
        <relativePath/>
    </parent>
    
    <!-- 项目基本信息 -->
    <groupId>com.mwu</groupId>
    <artifactId>geodistance</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>geodistance</name>
    <description>Redis Geographic Distance Calculator</description>
    <packaging>jar</packaging>
    
    <!-- 项目元数据 -->
    <url>https://github.com/your-org/geodistance</url>
    
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>
    
    <developers>
        <developer>
            <name>Your Name</name>
            <email>your.email@example.com</email>
            <organization>Your Organization</organization>
        </developer>
    </developers>
    
    <scm>
        <connection>scm:git:git://github.com/your-org/geodistance.git</connection>
        <developerConnection>scm:git:ssh://github.com/your-org/geodistance.git</developerConnection>
        <url>https://github.com/your-org/geodistance</url>
        <tag>HEAD</tag>
    </scm>
    
    <!-- 属性配置 -->
    <properties>
        <!-- Java 版本 -->
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>
        
        <!-- 编码和字符集 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        
        <!-- 依赖版本 -->
        <junit-bom.version>5.11.4</junit-bom.version>
        <testcontainers-bom.version>1.21.4</testcontainers-bom.version>
        
        <!-- 注解处理器版本 -->
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok.version>1.18.30</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        
        <!-- 代码质量工具版本 -->
        <jacoco.version>0.8.13</jacoco.version>
        <spotbugs.version>4.8.6.4</spotbugs.version>
        <checkstyle.version>10.18.2</checkstyle.version>
        <pmd.version>3.21.2</pmd.version>
        
        <!-- 文档版本 -->
        <springdoc-openapi.version>2.8.13</springdoc-openapi.version>
        
        <!-- Maven 插件版本 -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
        <maven-javadoc-plugin.version>3.7.0</maven-javadoc-plugin.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-gpg-plugin.version>3.2.5</maven-gpg-plugin.version>
        <maven-release-plugin.version>3.1.1</maven-release-plugin.version>
        <nexus-staging-maven-plugin.version>1.7.0</nexus-staging-maven-plugin.version>
        
        <!-- Testcontainers 版本 -->
        <testcontainer-junit.version>1.12.4</testcontainer-junit.version>
        <redis-testcontainer.version>2.2.4</redis-testcontainer.version>
        
        <!-- 代码覆盖率阈值 -->
        <jacoco.line.coverage>0.80</jacoco.line.coverage>
        <jacoco.branch.coverage>0.70</jacoco.branch.coverage>
    </properties>
    
    <!-- 依赖管理 -->
    <dependencies>
        <!-- Spring Boot 核心依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        
        <!-- Spring Boot Jackson -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
        
        <!-- API 文档 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc-openapi.version}</version>
        </dependency>
        
        <!-- 注解处理器 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        
        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- Testcontainers -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainer-junit.version}</version>
            <scope>test</scope>
        </dependency>
        
        <dependency>
            <groupId>com.redis</groupId>
            <artifactId>testcontainers-redis</artifactId>
            <version>${redis-testcontainer.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
    <!-- 构建配置 -->
    <build>
        <plugins>
            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <release>${java.version}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    
                    <!-- 注解处理器配置 -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    
                    <!-- 启用 Java 预览特性 -->
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                    
                    <!-- 显示编译警告 -->
                    <showWarnings>true</showWarnings>
                    <failOnWarning>false</failOnWarning>
                </configuration>
            </plugin>
            
            <!-- JaCoCo 代码覆盖率插件 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <!-- 准备 Agent -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    
                    <!-- 单元测试覆盖率报告 -->
                    <execution>
                        <id>report</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    
                    <!-- 完整测试覆盖率报告 -->
                    <execution>
                        <id>post-test-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    
                    <!-- 代码覆盖率检查 -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>PACKAGE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.coverage}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- SpotBugs 静态代码分析 -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <xmlOutput>true</xmlOutput>
                    <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs</artifactId>
                        <version>4.8.6</version>
                    </dependency>
                </dependencies>
            </plugin>
            
            <!-- Checkstyle 代码规范检查 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.version}</version>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>false</failsOnError>
                    <violationSeverity>warning</violationSeverity>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Surefire 单元测试插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <!-- 测试文件匹配模式 -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                    
                    <!-- JVM 参数 -->
                    <argLine>@{argLine} --enable-preview -Xmx512m</argLine>
                    
                    <!-- 并行执行配置 -->
                    <parallel>methods</parallel>
                    <threadCount>4</threadCount>
                    <perCoreThreadCount>false</perCoreThreadCount>
                    
                    <!-- 测试超时 -->
                    <forkedProcessTimeoutInSeconds>300</forkedProcessTimeoutInSeconds>
                    
                    <!-- 测试输出 -->
                    <useSystemClassLoader>false</useSystemClassLoader>
                </configuration>
            </plugin>
            
            <!-- Failsafe 集成测试插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe-plugin.version}</version>
                <configuration>
                    <!-- 测试文件匹配模式 -->
                    <includes>
                        <include>**/*IT.java</include>
                        <include>**/*IntegrationTest.java</include>
                        <include>**/*E2ETest.java</include>
                    </includes>
                    
                    <!-- JVM 参数 -->
                    <argLine>@{argLine} --enable-preview -Xmx1024m</argLine>
                    
                    <!-- 并行执行配置 -->
                    <parallel>classes</parallel>
                    <threadCount>2</threadCount>
                    
                    <!-- 测试超时 -->
                    <forkedProcessTimeoutInSeconds>600</forkedProcessTimeoutInSeconds>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Spring Boot Maven Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 排除编译时依赖 -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    
                    <!-- 可执行 JAR 配置 -->
                    <executable>true</executable>
                    
                    <!-- JVM 参数 -->
                    <jvmArguments>-Xms256m -Xmx1024m</jvmArguments>
                </configuration>
            </plugin>
            
            <!-- Maven JAR Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar-plugin.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                        <manifestEntries>
                            <Build-Time>${maven.build.timestamp}</Build-Time>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            
            <!-- Maven Source Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Maven Javadoc Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <charset>UTF-8</charset>
                    <docencoding>UTF-8</docencoding>
                    <source>${java.version}</source>
                    <additionalOptions>
                        <additionalOption>--enable-preview</additionalOption>
                    </additionalOptions>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            
            <!-- Maven GPG Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>${maven-gpg-plugin.version}</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <gpgArguments>
                        <arg>--pinentry-mode</arg>
                        <arg>loopback</arg>
                    </gpgArguments>
                </configuration>
            </plugin>
            
            <!-- Nexus Staging Maven Plugin -->
            <plugin>
                <groupId>org.sonatype.plugins</groupId>
                <artifactId>nexus-staging-maven-plugin</artifactId>
                <version>${nexus-staging-maven-plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <serverId>ossrh</serverId>
                    <nexusUrl>https://s01.oss.sonatype.org/</nexusUrl>
                    <autoReleaseAfterClose>true</autoReleaseAfterClose>
                </configuration>
            </plugin>
        </plugins>
    </build>
    
    <!-- 多环境配置 -->
    <profiles>
        <!-- 开发环境 -->
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <env>dev</env>
                <log.level>DEBUG</log.level>
            </properties>
        </profile>
        
        <!-- 测试环境 -->
        <profile>
            <id>test</id>
            <properties>
                <env>test</env>
                <log.level>INFO</log.level>
            </properties>
        </profile>
        
        <!-- 生产环境 -->
        <profile>
            <id>prod</id>
            <properties>
                <env>prod</env>
                <log.level>WARN</log.level>
            </properties>
        </profile>
        
        <!-- CI/CD 环境 -->
        <profile>
            <id>ci</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        
        <!-- 发布到 Maven Central -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
    
    <!-- 发布配置 -->
    <distributionManagement>
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
        <repository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>
</project>

<!-- 项目信息	groupId, artifactId, version, licenses, developers
Java 配置	Java 25 + 预览特性
依赖管理	Spring Boot, Lombok, MapStruct, Testcontainers
编译配置	Maven Compiler + 注解处理器
测试框架	Surefire (单元) + Failsafe (集成)
代码质量	JaCoCo + SpotBugs + Checkstyle
构建发布	Spring Boot Plugin + GPG + Nexus
环境配置	dev, test, prod, ci, release

-->



 <plugins>



            <!--
            源代码
               ↓
            ┌─────────────────────────────────────┐
            │  Maven Compiler Plugin              │
            │  ┌───────────────────────────────┐  │
            │  │ 1. 检查 Java 版本 (source=25)  │  │
            │  │ 2. 解析源代码                  │  │
            │  │ 3. 启用预览特性 (enable-preview) │
            │  └───────────────────────────────┘  │
            │  ┌───────────────────────────────┐  │
            │  │ 注解处理器:                   │  │
            │  │ 1. Lombok                     │  │
            │  │ 2. Lombok-MapStruct Binding   │  │
            │  │ 3. MapStruct                  │  │
            │  └───────────────────────────────┘  │
            └─────────────────────────────────────┘
               ↓
            生成的代码
               ↓
            再次编译
               ↓
            字节码 (target=25)
               ↓
            .class 文件
            -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <!-- source & target = 25
                        ↓
                    编译器行为:
                    - 接受 Java 25 语法
                    - 生成 Java 25 字节码 (version 75)
                    - 需要 JRE 25+ 运行
                    -->
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <!-- 注解处理器路径配置（核心）
                    注解处理器（Annotation Processor）是 Java 编译器的插件机制，在编译阶段处理自定义注解并生成代码。
                    源代码 (.java)            注解处理器              生成的代码
                        ↓                        ↓                        ↓
                    @Mapper           →    MapStruct Processor   →   MapperImpl.java
                    @Data            →     Lombok Processor     →   自动生成 getter/

                    -->
                    <annotationProcessorPaths>
                        <!-- 编译过程:

                        1. 解析源代码
                           ↓
                        2. 注解处理器执行
                           ├─ Lombok (生成 getter/setter/builder)
                           ├─ Lombok-MapStruct Binding (协调顺序)
                           └─ MapStruct (生成映射实现)
                           ↓
                        3. 收集生成的代码
                           ↓
                        4. 再次编译
                           ↓
                        5. 生成字节码 (.class)
                        -->
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <!--
                        没有 binding 的问题:

                        Lombok 先生成 Builder 方法
                        MapStruct 编译时可能看不到 Lombok 生成的代码
                        导致编译失败
                        有了 binding 后:

                        编译顺序:
                        1. Lombok 生成 Builder 方法
                        2. Lombok-MapStruct Binding 确保顺序
                        3. MapStruct 看到 Lombok 生成的代码
                        4. MapStruct 正确生成映射代码
                        -->

                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>--enable-preview</compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Lombok 是一个编译时注解处理器，只在编译阶段需要，不应该被打包到最终的 JAR 文件中。 -->

                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>



            <!-- JaCoCo Maven Plugin -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>post-test-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire 是 Maven 的标准测试执行插件，当您运行 mvn test 命令时，Maven 实际上就是通过 Surefire 来执行测试的。
            关键事实:
                Spring Boot 父 POM 已经内置了 Surefire 的默认配置
                您的项目即使没有显式声明 Surefire 插件， mvn test 仍然能正常工作
            why need
            Java 25 预览特性 (第30行)

                需要配置 enable-preview 以支持新特性测试
                Testcontainers 集成 (第105-116行)

                Testcontainers 可能需要特殊的 JVM 参数
                与 Redis testcontainers (第111-116行) 配合使用
                Jacoco 代码覆盖率 (第35行)

                需要通过 @{argLine} 传递参数
                Failsafe 插件版本 (第38行)

                已定义 maven-failsafe-plugin.version ，暗示可能需要集成测试支持
                场景	是否需要配置 Surefire
            简单项目，标准测试	❌ 不需要（使用默认配置）
            使用 Java 预览特性	✅ 需要（您的项目）
            使用 Testcontainers	✅ 需要（您的项目）
            需要代码覆盖率	✅ 需要（您的项目已引入 JaCoCo）
            集成测试	✅ 需要（使用 Failsafe）
             -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surfire-plugin.version}</version>
                <!-- 匹配模式: **/*Test.java
                ** 表示任意层级目录
                *Test.java 表示以 "Test" 结尾的 Java 文件
                示例: UserServiceTest.java , repository/UserRepositoryTest.java
                @{argLine} : Maven 变量引用

                保留其他插件可能设置的 JVM 参数
                确保参数不会互相覆盖
                enable-preview : 关键标志

                启用 Java 预览特性（Preview Features）
                允许使用尚未正式发布的 Java 新特性
                常用于测试即将发布的 Java 版本功能
                特性前瞻性: enable-preview 允许团队提前体验和测试 Java 新特性
                 -->


                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <argLine>@{argLine} --enable-preview</argLine>
                </configuration>
            </plugin>


            <!-- Maven Failsafe Plugin
            核心定位: Maven Failsafe 插件专门用于运行集成测试（Integration Tests），与 Surefire（单元测试）形成互补。
            集成测试（Integration Tests）: 测试应用程序与外部系统（数据库、消息队列、网络服务等）的交互行为
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe-plugin.version}</version>
                <configuration>
                    <argLine>@{argLine} --enable-preview</argLine>
                </configuration>
                <executions>
                    <!--
                    目标 1: integration-test
                    Maven 生命周期阶段: integration-test 阶段
                    执行时机: 在 test 阶段之后， package 阶段之前
                    作用: 运行集成测试
                    默认测试文件模式:
                    **/IT.java
                    **/*IT.java
                    **/*ITCase.java
                    **/*IntegrationTest.java
                    目标 2: verify
                    Maven 生命周期阶段: verify 阶段
                    执行时机: 在 integration-test 阶段之后
                    作用: 验证集成测试是否全部通过
                    关键行为: 如果任何集成测试失败，构建会失败
                    重要性: 确保部署前的质量门禁
                     -->
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Maven 生命周期中的位置
            完整生命周期:

            validate → compile → test → package → integration-test → verify → install → deploy
                                       ↑                    ↑
                                  (Surefire)          (Failsafe)
                                   单元测试              集成测试

        阶段	插件	测试类型	测试文件模式	失败行为
        test	Surefire	单元测试	*Test.java	构建失败
        integration-test	Failsafe	集成测试	*IT.java	仅记录结果
        verify	Failsafe	集成测试验证	-	构建失败
                     -->

        </plugins>
    </build>